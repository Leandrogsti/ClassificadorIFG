GROQ_API_KEY=cole_sua_chave_groq_aqui
GROQ_MODEL=openai/gpt-oss-20b

# Assine os cookies de sessão do Flask. Troque por um valor aleatório.
FLASK_SECRET_KEY=troque-por-um-valor-aleatorio

# Filtro BERTimbau (opcional). É um OVERRIDE: aponta um checkpoint de fora —
# outra pasta ou um repositório do Hugging Face — no lugar do modelo que a
# própria aplicação treinou. SEM ele, o pipeline usa o modelo treinado aqui
# (modelos/indicadores), e não "apenas a LLM". Só ative com um checkpoint
# AJUSTADO para estes indicadores: um BERTimbau puro não tem cabeça de
# classificação treinada e devolveria rótulos aleatórios.
# BERTIMBAU_MODELO=./modelos/bertimbau-indicadores
# BERTIMBAU_LIMIAR=0.5
